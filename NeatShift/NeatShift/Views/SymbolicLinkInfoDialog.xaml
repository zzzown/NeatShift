<?xml version="1.0" encoding="utf-8" ?>
<ui:ContentDialog
    x:Class="NeatShift.Views.SymbolicLinkInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NeatShift.Localization"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    Title="{loc:Translate LinkInfo_Title}"
    CloseButtonText="{loc:Translate Common_GotIt}"
    DefaultButton="Close">

    <ScrollViewer>
        <StackPanel Margin="0,10,0,0">
            <!-- What are Symbolic Links -->
            <TextBlock Text="{loc:Translate LinkInfo_What}"
                     Style="{StaticResource SubtitleTextBlockStyle}"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10"/>
            
            <TextBlock Text="{loc:Translate LinkInfo_WhatBody}"
                     TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- How They Work -->
            <TextBlock Text="{loc:Translate LinkInfo_How}"
                     Style="{StaticResource SubtitleTextBlockStyle}"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10"/>
            
            <TextBlock Text="{loc:Translate LinkInfo_HowBody}"
                     TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- Benefits -->
            <TextBlock Text="{loc:Translate LinkInfo_Benefits}"
                     Style="{StaticResource SubtitleTextBlockStyle}"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10"/>
            
            <TextBlock Text="{loc:Translate LinkInfo_BenefitsBody}"
                     TextWrapping="Wrap" Margin="0,0,0,20"/>

            <!-- Example -->
            <TextBlock Text="{loc:Translate LinkInfo_Example}"
                     Style="{StaticResource SubtitleTextBlockStyle}"
                     FontWeight="SemiBold"
                     Margin="0,0,0,10"/>
            
            <Border Background="{DynamicResource SystemControlBackgroundListLowBrush}"
                    Padding="15"
                    CornerRadius="4"
                    Margin="0,0,0,20">
                <TextBlock Text="{loc:Translate LinkInfo_ExampleBody}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Note -->
            <TextBlock Text="{loc:Translate LinkInfo_NoteAdmin}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                     FontStyle="Italic"
                     Margin="0,0,0,10"/>

            <TextBlock Text="{loc:Translate LinkInfo_NoteWhy}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                     FontStyle="Italic"/>
        </StackPanel>
    </ScrollViewer>
</ui:ContentDialog> 