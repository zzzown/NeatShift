<?xml version="1.0" encoding="utf-8" ?>
<ui:ContentDialog
    x:Class="NeatShift.Views.ContactDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NeatShift.Localization"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    Title="{loc:Translate Common_ContactUs}"
    CloseButtonText="{loc:Translate Common_Close}"
    DefaultButton="Close">

    <StackPanel Margin="0,10,0,0">
        <TextBlock Text="{loc:Translate Contact_Intro}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,20"/>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="Globe" 
                         Foreground="{DynamicResource AccentButtonBackground}"
                         Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1">
                <Hyperlink Click="Reddit_Click"><Run Text="{loc:Translate Contact_Reddit}"/></Hyperlink>
            </TextBlock>
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="Send" 
                         Foreground="{DynamicResource AccentButtonBackground}"
                         Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1">
                <Hyperlink Click="Telegram_Click"><Run Text="{loc:Translate Contact_Telegram}"/></Hyperlink>
            </TextBlock>
        </Grid>

        <Grid Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Symbol="Message" 
                         Foreground="{DynamicResource AccentButtonBackground}"
                         Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1">
                <Hyperlink Click="Discord_Click"><Run Text="{loc:Translate Contact_Discord}"/></Hyperlink>
            </TextBlock>
        </Grid>
    </StackPanel>
</ui:ContentDialog> 