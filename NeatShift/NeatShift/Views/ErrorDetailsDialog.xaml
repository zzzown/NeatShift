<Window x:Class="NeatShift.Views.ErrorDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NeatShift.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        mc:Ignorable="d"
        Title="{loc:Translate Error_Title}" Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        ui:WindowHelper.UseModernWindowStyle="True">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding IssueTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:Translate Error_BugDescription}" FontWeight="SemiBold"/>
                <TextBox Text="{Binding BugDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Margin="0,5,0,10" AcceptsReturn="True" MinLines="3"/>

                <TextBlock Text="{loc:Translate Error_SystemInfo}" FontWeight="SemiBold"/>
                <TextBox Text="{Binding SystemInfo}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,5,0,10" FontFamily="Consolas"/>

                <TextBlock Text="{loc:Translate Error_AdditionalContext}" FontWeight="SemiBold"/>
                <TextBox Text="{Binding AdditionalContext, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Margin="0,5,0,0" AcceptsReturn="True" MinLines="2"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{loc:Translate Error_OpenLogs}" Command="{Binding OpenLogsFolderCommand}" Margin="0,0,10,0"/>
            <Button Content="{loc:Translate Common_CopyToClipboard}" Command="{Binding CopyToClipboardCommand}" Margin="0,0,10,0"/>
            <Button Content="{loc:Translate Error_SubmitGitHub}" Command="{Binding SubmitOnGitHubCommand}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window> 